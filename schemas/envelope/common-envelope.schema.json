{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.9:commonEnvelope",
  "title": "Common Envelope",
  "type": "object",
  "properties": {
    "messageUri": {
      "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
    },
    "messageType": {
      "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "MAJOR.MINOR without the patch number. Pattern added in 0.6."
    },
    "originatingActor": {
      "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
    },
    "originatingRoleDeclaration": {
      "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
    },
    "addressedTo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorUri": {
            "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
          },
          "expectedRole": {
            "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
          }
        },
        "required": [
          "actorUri"
        ]
      }
    },
    "producedAt": {
      "$ref": "urn:ipproto:schema:0.9:defs#/$defs/isoDateTime"
    },
    "userContext": {
      "$ref": "urn:ipproto:schema:0.9:userContext"
    },
    "recordedBy": {
      "description": "Added in 0.5. The actor that entered this message on the originating actor's behalf, with the originator's consent. The originating actor stays the originator.",
      "type": "object",
      "properties": {
        "actorUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "userContext": {
          "$ref": "urn:ipproto:schema:0.9:userContext"
        }
      },
      "required": [
        "actorUri"
      ]
    },
    "recordedFrom": {
      "description": "Added in 0.6. How a message recorded by another actor reached it. Used only together with recordedBy.",
      "type": "object",
      "properties": {
        "channel": {
          "anyOf": [
            {
              "enum": [
                "email",
                "letter",
                "telephone",
                "inPerson",
                "fax",
                "portal",
                "other"
              ]
            },
            {
              "type": "string",
              "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
              "description": "Custom channel: a namespaced URN identifying the defining authority"
            }
          ]
        },
        "sourceDocument": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "receivedAt": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/isoDateTime"
        }
      }
    },
    "confidentiality": {
      "description": "Added in 0.6. How the content of the message may be handled. Under privileged: no broadcast, no bootstrap subscription invitations, resolution only for originator and addressees, no forwarding, no third-party asset lookup.",
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "privileged",
            "confidential",
            "normal"
          ]
        },
        "basis": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        }
      },
      "required": [
        "level"
      ]
    },
    "correlation": {
      "type": "object",
      "properties": {
        "correlatedToMessageUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "workstreamUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "milestoneUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "subscriptionUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "eventChainUri": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "urn:ipproto:schema:0.9:dataAssertion"
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "messageUri",
    "messageType",
    "protocolVersion",
    "originatingActor",
    "originatingRoleDeclaration",
    "addressedTo",
    "producedAt",
    "payload"
  ],
  "dependentRequired": {
    "recordedFrom": [
      "recordedBy"
    ]
  }
}
