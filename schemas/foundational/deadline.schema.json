{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.6:deadline",
  "title": "Deadline",
  "description": "A time limit the work must observe that the parties did not set for each other: court-ordered, statutory, agreed with a third party, or a hearing. Not a Service Level. Added in 0.6.",
  "type": "object",
  "properties": {
    "deadlineUri": {
      "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
    },
    "deadlineKind": {
      "anyOf": [
        {
          "enum": [
            "courtOrdered",
            "statutory",
            "agreed",
            "hearing"
          ]
        },
        {
          "type": "string",
          "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
          "description": "Custom deadline kind: a namespaced URN identifying the defining authority"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "basis": {
      "type": "object",
      "properties": {
        "basisText": {
          "type": "string"
        },
        "legalProvision": {
          "type": "string"
        },
        "basisDocument": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        }
      },
      "anyOf": [
        {
          "required": [
            "basisText"
          ]
        },
        {
          "required": [
            "legalProvision"
          ]
        },
        {
          "required": [
            "basisDocument"
          ]
        }
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "eventType": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "triggerDate": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDate"
        },
        "triggerDocument": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        }
      },
      "required": [
        "eventType"
      ]
    },
    "dueDate": {
      "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDate"
    },
    "dueAt": {
      "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
    },
    "jurisdictionCode": {
      "$ref": "urn:ipproto:schema:0.6:defs#/$defs/st3Code"
    },
    "appointment": {
      "type": "object",
      "properties": {
        "startsAt": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
        },
        "endsAt": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
        },
        "location": {
          "type": "string"
        },
        "attendanceMode": {
          "enum": [
            "inPerson",
            "remote",
            "hybrid"
          ]
        }
      },
      "required": [
        "startsAt"
      ]
    },
    "reminderDates": {
      "type": "array",
      "items": {
        "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDate"
      }
    },
    "supersedes": {
      "type": "object",
      "properties": {
        "deadlineUri": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "grantingDocument": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        }
      },
      "required": [
        "deadlineUri"
      ]
    },
    "status": {
      "enum": [
        "open",
        "met",
        "missed",
        "superseded",
        "withdrawn"
      ]
    },
    "metBy": {
      "type": "object",
      "properties": {
        "metAt": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
        },
        "messageUri": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "document": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        }
      },
      "required": [
        "metAt"
      ]
    },
    "milestoneReferences": {
      "type": "array",
      "items": {
        "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
      }
    }
  },
  "required": [
    "deadlineUri",
    "deadlineKind",
    "dueDate",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "deadlineKind": {
            "const": "hearing"
          }
        },
        "required": [
          "deadlineKind"
        ]
      },
      "then": {
        "required": [
          "appointment"
        ]
      },
      "else": {
        "properties": {
          "appointment": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "met"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "metBy"
        ]
      },
      "else": {
        "properties": {
          "metBy": false
        }
      }
    }
  ]
}
