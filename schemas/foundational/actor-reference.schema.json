{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.5:actorReference",
  "title": "Actor Reference",
  "type": "object",
  "properties": {
    "actorUri": {
      "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
    },
    "actorType": {
      "anyOf": [
        {
          "enum": [
            "corporateIpDepartment",
            "serviceProvider",
            "externalCounsel",
            "registerAuthority",
            "registerObserver",
            "ipmsVendor",
            "platformOperator",
            "paymentInstitution",
            "softwareService",
            "other"
          ]
        },
        {
          "type": "string",
          "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
          "description": "Custom actor type: a namespaced URN identifying the defining authority"
        }
      ]
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scheme": {
            "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
          },
          "value": {
            "type": "string"
          },
          "verifiedAt": {
            "$ref": "urn:ipproto:schema:0.5:defs#/$defs/isoDateTime"
          },
          "registrationAuthority": {
            "description": "Added in 0.5. The register that issued the identifier; required with the scheme urn:ipproto:scheme:companyRegister. Recommended: the register's code in the GLEIF Registration Authorities List.",
            "type": "string"
          }
        },
        "required": [
          "scheme",
          "value"
        ],
        "if": {
          "properties": {
            "scheme": {
              "const": "urn:ipproto:scheme:companyRegister"
            }
          },
          "required": [
            "scheme"
          ]
        },
        "then": {
          "required": [
            "registrationAuthority"
          ]
        }
      }
    },
    "legalName": {
      "type": "string"
    },
    "jurisdictionCode": {
      "$ref": "urn:ipproto:schema:0.5:defs#/$defs/st3Code"
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "displayLabel": {
      "type": "string"
    }
  },
  "required": [
    "actorUri",
    "actorType",
    "identifiers",
    "legalName"
  ]
}
