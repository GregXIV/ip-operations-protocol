{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.6:entityReference",
  "title": "Entity Reference",
  "type": "object",
  "properties": {
    "literal": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "sourceType": {
              "enum": [
                "register",
                "corporateRecord",
                "selfDeclaration",
                "derivedDocument",
                "other"
              ]
            },
            "sourceActorUri": {
              "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
            },
            "sourcePublicationDate": {
              "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDate"
            },
            "sourceDocumentReference": {
              "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
            }
          },
          "required": [
            "sourceType"
          ]
        }
      },
      "required": [
        "value",
        "source"
      ]
    },
    "resolution": {
      "type": "object",
      "properties": {
        "resolvedEntityUri": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "resolvedAt": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
        },
        "confidenceLevel": {
          "enum": [
            "exact",
            "high",
            "medium",
            "low"
          ]
        },
        "resolutionMethod": {
          "enum": [
            "deterministicIdentifier",
            "attributeMatching",
            "humanReview",
            "priorAssertion",
            "automated"
          ]
        },
        "resolutionBasis": {
          "type": "object"
        }
      },
      "required": [
        "resolvedEntityUri",
        "resolvedAt"
      ]
    },
    "identifiers": {
      "description": "Added in 0.6. Identifiers of the entity known to the asserter, as on Actor Reference.",
      "type": "array",
      "items": {
        "$ref": "urn:ipproto:schema:0.6:defs#/$defs/identifier"
      }
    },
    "aliases": {
      "description": "Added in 0.6. Other names under which the entity is known.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crossActorReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorUri": {
            "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
          },
          "entityUriInActor": {
            "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
          }
        },
        "required": [
          "actorUri",
          "entityUriInActor"
        ]
      }
    }
  },
  "required": [
    "literal"
  ]
}
