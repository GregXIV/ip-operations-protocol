{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.8:agreedPrice",
  "title": "Agreed Price",
  "description": "A binding price for a unit of work, as opposed to an estimate. Carried on a milestone, in a work instruction and a mandate instruction, and as the price of a bid.",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "currency": {
      "$ref": "urn:ipproto:schema:0.8:defs#/$defs/iso4217"
    },
    "priceBasis": {
      "enum": [
        "fixed",
        "capped",
        "hourly",
        "periodicFlat"
      ]
    },
    "lineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineItemType": {
            "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
          },
          "amount": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "lineItemType",
          "amount"
        ]
      }
    },
    "periodicity": {
      "description": "Added in 0.7. Required when priceBasis is periodicFlat, not used otherwise.",
      "enum": [
        "monthly",
        "quarterly",
        "semiAnnual",
        "annual"
      ]
    },
    "rateTable": {
      "description": "Added in 0.7. Rates for time-based work per role or per timekeeper; used with hourly and capped.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rateRole": {
            "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
          },
          "timekeeper": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "rateUnit": {
            "enum": [
              "hour",
              "day"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rate"
        ],
        "anyOf": [
          {
            "required": [
              "rateRole"
            ]
          },
          {
            "required": [
              "timekeeper"
            ]
          }
        ]
      }
    },
    "budget": {
      "description": "Added in 0.7. An agreed expectation of cost with a rule for exceeding it; not a cap.",
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "onExceeding": {
          "enum": [
            "notify",
            "approvalRequired"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "onExceeding"
      ]
    },
    "statutoryFeeFloor": {
      "description": "Added in 0.7. A statutory fee schedule the fee is not below.",
      "type": "object",
      "properties": {
        "feeSchedule": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
        },
        "valueOfMatter": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/money"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "feeSchedule"
      ]
    },
    "officialFeesIncluded": {
      "type": "boolean"
    },
    "bindingUntil": {
      "$ref": "urn:ipproto:schema:0.8:defs#/$defs/isoDateTime"
    },
    "agreementReference": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "currency",
    "priceBasis",
    "officialFeesIncluded"
  ],
  "if": {
    "properties": {
      "priceBasis": {
        "const": "periodicFlat"
      }
    },
    "required": [
      "priceBasis"
    ]
  },
  "then": {
    "required": [
      "periodicity"
    ]
  },
  "else": {
    "not": {
      "required": [
        "periodicity"
      ]
    }
  }
}
