{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.1:resolutionProvenance",
  "title": "Resolution Provenance",
  "description": "How an observed-identifier set was resolved to a canonical asset. Produced by any resolver. Defined in the Asset Identification and Resolution profile.",
  "type": "object",
  "properties": {
    "resolvedAssetUri": {
      "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "confidenceLevel": {
      "enum": [
        "exact",
        "high",
        "medium",
        "low"
      ]
    },
    "resolutionMethod": {
      "enum": [
        "deterministicIdentifier",
        "familyLookup",
        "attributeMatching",
        "humanReview",
        "priorAssertion"
      ]
    },
    "resolutionBasis": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "epoOps",
            "jpo",
            "national",
            "priorAssertion"
          ]
        },
        "matchedIdentifiers": {
          "type": "array"
        },
        "docdbFamilyId": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ]
    },
    "inputIdentifiers": {
      "type": "array"
    }
  },
  "required": [
    "resolvedAssetUri",
    "resolvedAt",
    "confidenceLevel",
    "resolutionMethod",
    "resolutionBasis"
  ]
}
