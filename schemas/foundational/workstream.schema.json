{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.7:workstream",
  "title": "Workstream",
  "type": "object",
  "properties": {
    "workstreamUri": {
      "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
    },
    "workstreamType": {
      "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
    },
    "assetReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
      }
    },
    "prospectiveRights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:ipproto:schema:0.7:defs#/$defs/prospectiveRight"
      }
    },
    "assetRoles": {
      "description": "Added in 0.7. The role each asset plays in a dispute; every assetUri is an entry of assetReferences.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetUri": {
            "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "patentInSuit",
                  "challengedPatent",
                  "counterAsserted",
                  "other"
                ]
              },
              {
                "type": "string",
                "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
                "description": "Custom value: a namespaced URN identifying the defining authority"
              }
            ]
          },
          "proceedingReference": {
            "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
          }
        },
        "required": [
          "assetUri",
          "role"
        ]
      }
    },
    "proceedings": {
      "description": "Added in 0.7. The proceedings in which the work is done, with their parties. Carried only to the workstream's own actors.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proceedingUri": {
            "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
          },
          "proceedingType": {
            "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
          },
          "forum": {
            "$ref": "urn:ipproto:schema:0.7:entityReference"
          },
          "forumDocketNumber": {
            "type": "string"
          },
          "instance": {
            "anyOf": [
              {
                "enum": [
                  "firstInstance",
                  "appeal",
                  "furtherAppeal"
                ]
              },
              {
                "type": "string",
                "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
                "description": "Custom value: a namespaced URN identifying the defining authority"
              }
            ]
          },
          "parties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:ipproto:schema:0.7:defs#/$defs/proceedingParty"
            }
          },
          "relatedProceedings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "proceedingUri": {
                  "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
                },
                "relationshipType": {
                  "anyOf": [
                    {
                      "enum": [
                        "appealFrom",
                        "counterclaimIn",
                        "consolidatedWith",
                        "stayedPending"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
                      "description": "Custom value: a namespaced URN identifying the defining authority"
                    }
                  ]
                }
              },
              "required": [
                "proceedingUri",
                "relationshipType"
              ]
            }
          }
        },
        "required": [
          "proceedingUri",
          "proceedingType",
          "forum",
          "parties"
        ]
      }
    },
    "triggeringEvent": {
      "type": "object",
      "properties": {
        "eventType": {
          "enum": [
            "registerEvent",
            "clientRequest",
            "subscriptionFinding",
            "internalDecision",
            "manualEntry"
          ]
        },
        "eventReference": {
          "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
        },
        "triggeredAt": {
          "$ref": "urn:ipproto:schema:0.7:defs#/$defs/isoDateTime"
        }
      },
      "required": [
        "eventType",
        "triggeredAt"
      ]
    },
    "goalStatement": {
      "type": "object",
      "properties": {
        "goalText": {
          "type": "string"
        },
        "goalCategory": {
          "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
        },
        "goalConstraints": {
          "type": "object",
          "properties": {
            "deadlineConstraints": {
              "description": "Since 0.6 an array of Deadline structures: the deadlines the goal must observe.",
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.7:deadline"
              }
            }
          }
        }
      },
      "required": [
        "goalText"
      ]
    },
    "instructingCapacity": {
      "enum": [
        "own",
        "onBehalf"
      ]
    },
    "beneficiary": {
      "$ref": "urn:ipproto:schema:0.7:entityReference"
    },
    "milestoneChain": {
      "type": "object",
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.7:milestone"
          }
        },
        "chainExecutionPolicy": {
          "enum": [
            "strict",
            "optimistic",
            "manual"
          ]
        }
      },
      "required": [
        "milestones"
      ]
    },
    "workstreamStatus": {
      "enum": [
        "proposed",
        "committed",
        "inProgress",
        "completed",
        "abandoned",
        "disputed"
      ]
    },
    "statusHistory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authorityRegistry": {
      "type": "array",
      "items": {
        "$ref": "urn:ipproto:schema:0.7:defs#/$defs/uri"
      }
    },
    "createdAt": {
      "$ref": "urn:ipproto:schema:0.7:defs#/$defs/isoDateTime"
    },
    "committedAt": {
      "$ref": "urn:ipproto:schema:0.7:defs#/$defs/isoDateTime"
    },
    "completedAt": {
      "$ref": "urn:ipproto:schema:0.7:defs#/$defs/isoDateTime"
    },
    "relatedWorkstreams": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "workstreamUri",
    "workstreamType",
    "triggeringEvent",
    "goalStatement",
    "milestoneChain",
    "workstreamStatus"
  ],
  "anyOf": [
    {
      "required": [
        "assetReferences"
      ]
    },
    {
      "required": [
        "prospectiveRights"
      ]
    }
  ],
  "if": {
    "properties": {
      "instructingCapacity": {
        "const": "onBehalf"
      }
    },
    "required": [
      "instructingCapacity"
    ]
  },
  "then": {
    "required": [
      "beneficiary"
    ]
  }
}
