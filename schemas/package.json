{
  "name": "@ipproto/schemas",
  "version": "0.9.1",
  "description": "JSON Schemas, validated examples, generated TypeScript types, and a reference validator for the IP Operations Protocol v0.9.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregXIV/ip-operations-protocol.git",
    "directory": "schemas"
  },
  "homepage": "https://guardianlabs.io",
  "bugs": {
    "url": "https://github.com/GregXIV/ip-operations-protocol/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "types": "./types/ipproto.d.ts",
  "exports": {
    "./index": "./index.json",
    "./types": "./types/ipproto.d.ts",
    "./validate": "./validate.mjs",
    "./validator": "./lib/validator.mjs",
    "./schemas/*": "./*"
  },
  "bin": {
    "ipproto-validate": "./validate.mjs"
  },
  "files": [
    "defs",
    "envelope",
    "foundational",
    "messages",
    "examples",
    "types",
    "index.json",
    "lib",
    "conformance",
    "validate.mjs",
    "README.md"
  ],
  "scripts": {
    "validate": "node validate.mjs",
    "generate-types": "node generate-types.mjs"
  },
  "peerDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4"
  },
  "keywords": [
    "ip-operations-protocol",
    "ipproto",
    "patent",
    "json-schema"
  ]
}
