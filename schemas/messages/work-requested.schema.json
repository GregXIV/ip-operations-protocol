{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.5:workRequested",
  "title": "Work Requested",
  "description": "A work requester places an order or asks for work, on existing assets, on rights still to be created, or both. Opens a catalogue order or one of the three procurement paths.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.5:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:workRequested"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestReference": {
          "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
        },
        "goalStatement": {
          "type": "object",
          "properties": {
            "goalText": {
              "type": "string"
            },
            "goalCategory": {
              "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
            },
            "goalConstraints": {
              "type": "object"
            }
          },
          "required": [
            "goalText"
          ]
        },
        "assetReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
          }
        },
        "prospectiveRights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:ipproto:schema:0.5:defs#/$defs/prospectiveRight"
          }
        },
        "requestedWork": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "milestoneCategory": {
                "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
              },
              "jurisdictionCode": {
                "$ref": "urn:ipproto:schema:0.5:defs#/$defs/st3Code"
              }
            },
            "required": [
              "milestoneCategory"
            ]
          }
        },
        "instructingCapacity": {
          "enum": [
            "own",
            "onBehalf"
          ]
        },
        "beneficiary": {
          "$ref": "urn:ipproto:schema:0.5:entityReference"
        },
        "requestMode": {
          "enum": [
            "catalogueOrder",
            "directQuote",
            "panel",
            "openRfp"
          ]
        },
        "offerReference": {
          "type": "string"
        },
        "preAuthorized": {
          "type": "boolean"
        },
        "responseDeadline": {
          "$ref": "urn:ipproto:schema:0.5:defs#/$defs/isoDateTime"
        }
      },
      "required": [
        "requestReference",
        "goalStatement",
        "requestedWork",
        "instructingCapacity",
        "requestMode"
      ],
      "anyOf": [
        {
          "required": [
            "assetReferences"
          ]
        },
        {
          "required": [
            "prospectiveRights"
          ]
        }
      ],
      "if": {
        "properties": {
          "instructingCapacity": {
            "const": "onBehalf"
          }
        },
        "required": [
          "instructingCapacity"
        ]
      },
      "then": {
        "required": [
          "beneficiary"
        ]
      }
    }
  },
  "required": [
    "payload"
  ]
}
