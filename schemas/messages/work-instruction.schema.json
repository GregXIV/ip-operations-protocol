{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.8:workInstruction",
  "title": "Work Instruction",
  "description": "A work requester instructs a work provider to perform one milestone at an agreed price and under agreed service levels.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.8:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:workInstruction"
    },
    "payload": {
      "type": "object",
      "properties": {
        "milestoneReference": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
        },
        "instruction": {
          "type": "object",
          "properties": {
            "instructionText": {
              "type": "string"
            },
            "instructionConstraints": {
              "type": "object"
            }
          },
          "required": [
            "instructionText"
          ]
        },
        "agreedPrice": {
          "$ref": "urn:ipproto:schema:0.8:agreedPrice"
        },
        "serviceLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:ipproto:schema:0.8:serviceLevel"
          },
          "description": "Required unless the envelope carries recordedBy (an instruction recorded by its provider); relaxed in 0.7."
        },
        "providedDocuments": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
          }
        },
        "expectedDeliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "deliverableType": {
                "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
              },
              "documentType": {
                "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
              }
            },
            "anyOf": [
              {
                "required": [
                  "deliverableType"
                ]
              },
              {
                "required": [
                  "documentType"
                ]
              }
            ]
          }
        },
        "responseDeadline": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/isoDateTime",
          "description": "Required unless the envelope carries recordedBy (an instruction recorded by its provider); relaxed in 0.7."
        },
        "conflictParties": {
          "description": "Added in 0.6. The parties the provider checks for conflicts of interest before it accepts.",
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.8:defs#/$defs/conflictParty"
          }
        }
      },
      "required": [
        "milestoneReference",
        "instruction",
        "agreedPrice",
        "providedDocuments",
        "expectedDeliverables"
      ]
    }
  },
  "required": [
    "payload"
  ],
  "if": {
    "required": [
      "recordedBy"
    ]
  },
  "then": {},
  "else": {
    "properties": {
      "payload": {
        "required": [
          "serviceLevels",
          "responseDeadline"
        ]
      }
    }
  }
}
