{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.8:serviceSubscriptionStarted",
  "title": "Service Subscription Started",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.8:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:serviceSubscriptionStarted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "subscriptionReference": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
        },
        "subscriptionType": {
          "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
        },
        "subscriptionScope": {
          "type": "object",
          "properties": {
            "scopedAssetReferences": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
              }
            },
            "scopedDefinition": {
              "type": "object"
            },
            "scopeStartDate": {
              "type": "string",
              "format": "date-time"
            },
            "scopeEndDate": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "scopedAssetReferences",
            "scopeStartDate"
          ]
        },
        "actorAssignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "actorUri": {
                "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
              },
              "roleDeclarationUri": {
                "$ref": "urn:ipproto:schema:0.8:defs#/$defs/uri"
              },
              "assignmentType": {
                "enum": [
                  "subscriptionProvider",
                  "subscriptionContractHolder",
                  "subscriptionOperator",
                  "subscriber",
                  "payor",
                  "accountableTo"
                ]
              },
              "payorShare": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100,
                "description": "Added in 0.8. Only on a payor assignment: this payor's share, in percent, of the charges for the milestone or subscription. The shares of all payor assignments add up to 100 (a spec rule)."
              }
            },
            "required": [
              "actorUri",
              "roleDeclarationUri",
              "assignmentType"
            ],
            "if": {
              "properties": {
                "assignmentType": {
                  "not": {
                    "const": "payor"
                  }
                }
              },
              "required": [
                "assignmentType"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "payorShare"
                ]
              }
            }
          }
        },
        "cadence": {
          "type": "object",
          "properties": {
            "cadenceType": {
              "enum": [
                "eventDriven",
                "periodic",
                "hybrid"
              ]
            },
            "periodicSchedule": {
              "type": "object"
            },
            "eventTriggers": {
              "type": "array"
            }
          },
          "required": [
            "cadenceType"
          ]
        },
        "commercialTerms": {
          "type": "object",
          "properties": {
            "feeStructure": {
              "enum": [
                "flatPeriodicFee",
                "perFindingFee",
                "tieredFee",
                "revenueShare",
                "custom"
              ]
            },
            "feeAmount": {
              "type": "object",
              "properties": {
                "sharePercent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "billingCadence": {
              "enum": [
                "inAdvance",
                "inArrears",
                "perFinding",
                "custom"
              ]
            },
            "commercialAgreementReference": {
              "type": "string"
            },
            "planReference": {
              "type": "string"
            },
            "trial": {
              "type": "object",
              "properties": {
                "trialEndsAt": {
                  "$ref": "urn:ipproto:schema:0.8:defs#/$defs/isoDateTime"
                },
                "afterTrial": {
                  "enum": [
                    "convertsToPaid",
                    "endsUnlessConfirmed"
                  ]
                }
              },
              "required": [
                "trialEndsAt",
                "afterTrial"
              ]
            }
          },
          "required": [
            "feeStructure",
            "billingCadence"
          ],
          "if": {
            "properties": {
              "feeStructure": {
                "const": "revenueShare"
              }
            },
            "required": [
              "feeStructure"
            ]
          },
          "then": {
            "required": [
              "feeAmount"
            ],
            "properties": {
              "feeAmount": {
                "required": [
                  "sharePercent"
                ]
              }
            }
          }
        },
        "findingsConfiguration": {
          "type": "object",
          "properties": {
            "findingDeliveryMethod": {
              "enum": [
                "serviceFinding",
                "aggregatedReport",
                "notificationOnly"
              ]
            },
            "findingSeverityThresholds": {
              "type": "object"
            },
            "findingRecipients": {
              "type": "array"
            }
          },
          "required": [
            "findingDeliveryMethod"
          ]
        },
        "subscriptionAuthorityClaims": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.8:authorityClaim"
          }
        }
      },
      "required": [
        "subscriptionReference",
        "subscriptionType",
        "subscriptionScope",
        "actorAssignments",
        "cadence",
        "commercialTerms",
        "findingsConfiguration",
        "subscriptionAuthorityClaims"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
