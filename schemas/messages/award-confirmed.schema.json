{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.2:awardConfirmed",
  "title": "Award Confirmed",
  "description": "One side confirms a proposed award. The award stands when both the bidder and the work requester have confirmed, which commits the milestone.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.2:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:awardConfirmed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "awardReference": {
          "$ref": "urn:ipproto:schema:0.2:defs#/$defs/uri"
        },
        "confirmedBy": {
          "$ref": "urn:ipproto:schema:0.2:userContext"
        },
        "confirmingRole": {
          "$ref": "urn:ipproto:schema:0.2:defs#/$defs/uri"
        }
      },
      "required": [
        "awardReference",
        "confirmedBy",
        "confirmingRole"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
