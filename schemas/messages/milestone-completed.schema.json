{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.1:milestoneCompleted",
  "title": "Milestone Completed",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.1:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:milestoneCompleted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "milestoneReference": {
          "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
        },
        "completedAt": {
          "$ref": "urn:ipproto:schema:0.1:defs#/$defs/isoDateTime"
        },
        "actuals": {
          "type": "object",
          "properties": {
            "actualCost": {
              "$ref": "urn:ipproto:schema:0.1:defs#/$defs/money"
            },
            "actualDuration": {
              "type": "integer"
            },
            "varianceFromEstimate": {
              "type": "string"
            }
          }
        },
        "outputs": {
          "type": "object",
          "properties": {
            "producedDocuments": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
              }
            },
            "producedSubscriptions": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
              }
            },
            "producedAssertions": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
              }
            }
          }
        },
        "completionType": {
          "enum": [
            "definitiveCompletion",
            "awaitingExternalAction"
          ]
        },
        "acknowledgmentRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "milestoneReference",
        "completedAt",
        "actuals",
        "outputs",
        "completionType"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
