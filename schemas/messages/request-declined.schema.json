{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.3:requestDeclined",
  "title": "Request Declined",
  "description": "An orchestrator declines a work request, with the reason. No workstream is created.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.3:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:requestDeclined"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestReference": {
          "$ref": "urn:ipproto:schema:0.3:defs#/$defs/uri"
        },
        "declineReason": {
          "type": "object",
          "properties": {
            "reasonCategory": {
              "enum": [
                "serviceNotOffered",
                "offerNotAvailable",
                "requesterNotEligible",
                "conflictOfInterest",
                "noSupplierAvailable",
                "insufficientInformation",
                "other"
              ]
            },
            "reasonNarrative": {
              "type": "string"
            }
          },
          "required": [
            "reasonCategory"
          ]
        }
      },
      "required": [
        "requestReference",
        "declineReason"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
