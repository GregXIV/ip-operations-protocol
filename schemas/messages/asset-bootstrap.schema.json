{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.6:assetBootstrap",
  "title": "Asset Bootstrap",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.6:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:assetBootstrap"
    },
    "payload": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "urn:ipproto:schema:0.6:assetReference"
        },
        "bootstrapBasis": {
          "type": "object",
          "properties": {
            "basisType": {
              "enum": [
                "registerDetection",
                "corporateIntroduction",
                "serviceProviderInitialization",
                "protocolMigration",
                "manualEntry"
              ]
            },
            "triggeringReference": {
              "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
            }
          },
          "required": [
            "basisType"
          ]
        },
        "initialAssertions": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.6:dataAssertion"
          }
        },
        "initialAuthorityClaims": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.6:authorityClaim"
          }
        },
        "subscriptionInvitations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "asset",
        "bootstrapBasis",
        "initialAssertions",
        "initialAuthorityClaims"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
