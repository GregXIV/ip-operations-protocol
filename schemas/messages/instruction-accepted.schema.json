{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.3:instructionAccepted",
  "title": "Instruction Accepted",
  "description": "A work provider accepts a work instruction. Binds both sides to the instruction's price and service levels and commits the milestone.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.3:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:instructionAccepted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "instructionReference": {
          "$ref": "urn:ipproto:schema:0.3:defs#/$defs/uri"
        },
        "acceptedAt": {
          "$ref": "urn:ipproto:schema:0.3:defs#/$defs/isoDateTime"
        },
        "responsibleUser": {
          "$ref": "urn:ipproto:schema:0.3:userContext"
        }
      },
      "required": [
        "instructionReference",
        "acceptedAt"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
