{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.1:assetAuthorityDispute",
  "title": "Asset Authority Dispute",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.1:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:assetAuthorityDispute"
    },
    "payload": {
      "type": "object",
      "properties": {
        "disputeReference": {
          "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
        },
        "disputedRecord": {
          "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
        },
        "disputedSectionPath": {
          "$ref": "urn:ipproto:schema:0.1:defs#/$defs/jsonPointer"
        },
        "competingClaims": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
          }
        },
        "conflictType": {
          "enum": [
            "overlappingExclusive",
            "sourceOfTruthChallenge",
            "supersessionDispute",
            "expiredClaim",
            "delegationChainBroken"
          ]
        },
        "disputeNarrative": {
          "type": "string"
        },
        "disputeRoutingTarget": {
          "type": "object",
          "properties": {
            "targetActorUri": {
              "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
            },
            "targetRoleDeclaration": {
              "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
            },
            "routingBasis": {
              "type": "string"
            }
          },
          "required": [
            "targetActorUri"
          ]
        },
        "disputeImpact": {
          "type": "object",
          "properties": {
            "blockedAssertions": {
              "type": "array"
            },
            "blockedMilestones": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
              }
            },
            "blockedWorkstreams": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.1:defs#/$defs/uri"
              }
            }
          }
        },
        "proposedResolution": {
          "type": "object",
          "properties": {
            "resolutionType": {
              "enum": [
                "revokeClaim",
                "narrowClaimScope",
                "extendClaimTimebound",
                "transferClaim",
                "acknowledgeJointHolding",
                "other"
              ]
            },
            "resolutionDescription": {
              "type": "string"
            }
          }
        },
        "responseDeadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "disputeReference",
        "disputedRecord",
        "disputedSectionPath",
        "competingClaims",
        "conflictType",
        "disputeNarrative",
        "disputeRoutingTarget",
        "disputeImpact",
        "responseDeadline"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
