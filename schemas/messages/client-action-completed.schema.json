{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.2:clientActionCompleted",
  "title": "Client Action Completed",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.2:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:clientActionCompleted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "artifactReadyReference": {
          "$ref": "urn:ipproto:schema:0.2:defs#/$defs/uri"
        },
        "actionPerformedAt": {
          "$ref": "urn:ipproto:schema:0.2:defs#/$defs/isoDateTime"
        },
        "performingUserContext": {
          "$ref": "urn:ipproto:schema:0.2:userContext"
        },
        "evidence": {
          "$ref": "urn:ipproto:schema:0.2:evidenceCollection"
        },
        "actionOutcome": {
          "enum": [
            "successfullyPerformed",
            "partiallyPerformed",
            "couldNotPerform",
            "performedWithDeviation"
          ]
        },
        "outcomeDetails": {
          "$ref": "urn:ipproto:schema:0.2:outcomeDetails"
        }
      },
      "required": [
        "artifactReadyReference",
        "actionPerformedAt",
        "evidence",
        "actionOutcome"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
