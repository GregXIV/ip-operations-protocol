{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.5:bidInvitation",
  "title": "Bid Invitation",
  "description": "An orchestrator invites suppliers to bid on one milestone. Opens the procurement sequence behind the execution mode thirdPartyRfp.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.5:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:bidInvitation"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestReference": {
          "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
        },
        "milestoneReference": {
          "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
        },
        "scope": {
          "type": "object",
          "properties": {
            "scopeText": {
              "type": "string"
            },
            "milestoneCategory": {
              "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
            },
            "jurisdictionCode": {
              "$ref": "urn:ipproto:schema:0.5:defs#/$defs/st3Code"
            },
            "assetReferences": {
              "type": "array",
              "items": {
                "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
              }
            },
            "prospectiveRights": {
              "type": "array",
              "minItems": 1,
              "description": "The rights the work is to create or prepare where no asset exists yet, as on Work Requested. While requesterIdentityWithheld is true no entry carries an applicant. Added in 0.4.",
              "items": {
                "$ref": "urn:ipproto:schema:0.5:defs#/$defs/prospectiveRight"
              }
            }
          },
          "required": [
            "scopeText"
          ]
        },
        "lineItemTemplate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:ipproto:schema:0.5:defs#/$defs/uri"
          }
        },
        "bidDeadline": {
          "$ref": "urn:ipproto:schema:0.5:defs#/$defs/isoDateTime"
        },
        "audience": {
          "enum": [
            "single",
            "panel",
            "open"
          ]
        },
        "conflictParties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "partyRole": {
                "enum": [
                  "beneficiary",
                  "adverseParty",
                  "other"
                ]
              },
              "party": {
                "$ref": "urn:ipproto:schema:0.5:entityReference"
              }
            },
            "required": [
              "partyRole",
              "party"
            ]
          }
        },
        "requesterIdentityWithheld": {
          "type": "boolean"
        },
        "requester": {
          "$ref": "urn:ipproto:schema:0.5:actorReference",
          "description": "The work requester, as in Requester Disclosed. Included when the requester's identity is not withheld; must be absent while requesterIdentityWithheld is true. Not required, so that a 0.3 invitation stays valid. Added in 0.4."
        }
      },
      "required": [
        "requestReference",
        "milestoneReference",
        "scope",
        "lineItemTemplate",
        "bidDeadline",
        "audience",
        "conflictParties"
      ],
      "if": {
        "properties": {
          "requesterIdentityWithheld": {
            "const": true
          }
        },
        "required": [
          "requesterIdentityWithheld"
        ]
      },
      "then": {
        "properties": {
          "requester": false,
          "scope": {
            "properties": {
              "prospectiveRights": {
                "items": {
                  "properties": {
                    "applicant": false
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "payload"
  ]
}
