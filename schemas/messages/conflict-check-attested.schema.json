{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.9:conflictCheckAttested",
  "title": "Conflict Check Attested",
  "description": "A provider attests the outcome of its conflict check against the parties of the work it is asked to take: a bid invitation, a work instruction, a mandate instruction or a request. Only the attestation is exchanged, not the method. Generalised in 0.6.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.9:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:conflictCheckAttested"
    },
    "payload": {
      "type": "object",
      "properties": {
        "subjectReference": {
          "description": "Added in 0.6. What the attestation is about.",
          "type": "object",
          "properties": {
            "subjectType": {
              "enum": [
                "bidInvitation",
                "workInstruction",
                "mandateInstruction",
                "request"
              ]
            },
            "reference": {
              "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
            }
          },
          "required": [
            "subjectType",
            "reference"
          ]
        },
        "invitationReference": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "checkedParties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "urn:ipproto:schema:0.9:entityReference"
              },
              {
                "$ref": "urn:ipproto:schema:0.9:defs#/$defs/conflictParty"
              }
            ]
          }
        },
        "checkedAt": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/isoDateTime"
        },
        "outcome": {
          "enum": [
            "clear",
            "clearedAfterReview",
            "conflict"
          ]
        },
        "attestedBy": {
          "$ref": "urn:ipproto:schema:0.9:userContext"
        }
      },
      "required": [
        "checkedParties",
        "outcome",
        "attestedBy"
      ],
      "anyOf": [
        {
          "required": [
            "subjectReference"
          ]
        },
        {
          "required": [
            "invitationReference"
          ]
        }
      ]
    }
  },
  "required": [
    "payload"
  ]
}
