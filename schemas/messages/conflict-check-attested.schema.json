{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.4:conflictCheckAttested",
  "title": "Conflict Check Attested",
  "description": "A bidder attests the outcome of its conflict check against the parties named in a bid invitation. Only the attestation is exchanged, not the method.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.4:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:conflictCheckAttested"
    },
    "payload": {
      "type": "object",
      "properties": {
        "invitationReference": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
        },
        "checkedParties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:ipproto:schema:0.4:entityReference"
          }
        },
        "outcome": {
          "enum": [
            "clear",
            "conflict"
          ]
        },
        "attestedBy": {
          "$ref": "urn:ipproto:schema:0.4:userContext"
        }
      },
      "required": [
        "invitationReference",
        "checkedParties",
        "outcome",
        "attestedBy"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
