{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.9:paymentExecuted",
  "title": "Payment Executed",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.9:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:paymentExecuted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "paymentReference": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "authorizationReference": {
          "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
        },
        "executedAt": {
          "type": "string",
          "format": "date-time"
        },
        "executingUserContext": {
          "$ref": "urn:ipproto:schema:0.9:userContext"
        },
        "executedAmount": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "$ref": "urn:ipproto:schema:0.9:defs#/$defs/iso4217"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "executionDeviation": {
          "type": "object"
        },
        "executionEvidence": {
          "$ref": "urn:ipproto:schema:0.9:evidenceCollection"
        },
        "executionOutcome": {
          "enum": [
            "successfullyExecuted",
            "executionFailed",
            "executionPartial",
            "executionPending"
          ]
        },
        "failureDetails": {
          "type": "object",
          "properties": {
            "failureCategory": {
              "enum": [
                "insufficientFunds",
                "bankingSystemError",
                "payeeRejection",
                "complianceHold",
                "currencyConversionFailure",
                "other"
              ]
            },
            "failureNarrative": {
              "type": "string"
            },
            "recoverable": {
              "type": "boolean"
            },
            "suggestedRemediation": {
              "type": "string"
            }
          }
        },
        "invoiceReferences": {
          "type": "array",
          "minItems": 1,
          "description": "Added in 0.8. The invoices the payment settles, with the amount applied to each where the payment settles several or part of one.",
          "items": {
            "type": "object",
            "properties": {
              "invoiceReference": {
                "$ref": "urn:ipproto:schema:0.9:defs#/$defs/uri"
              },
              "appliedAmount": {
                "$ref": "urn:ipproto:schema:0.9:defs#/$defs/money"
              }
            },
            "required": [
              "invoiceReference"
            ]
          }
        }
      },
      "required": [
        "paymentReference",
        "authorizationReference",
        "executedAt",
        "executedAmount",
        "executionEvidence",
        "executionOutcome"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
