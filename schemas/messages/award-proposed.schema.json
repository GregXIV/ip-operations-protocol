{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.4:awardProposed",
  "title": "Award Proposed",
  "description": "A work requester proposes to award the milestone to one bid.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.4:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:awardProposed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "bidReference": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
        },
        "confirmationDeadline": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/isoDateTime"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "bidReference",
        "confirmationDeadline"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
