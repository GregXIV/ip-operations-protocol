{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.4:requesterDisclosed",
  "title": "Requester Disclosed",
  "description": "An orchestrator discloses the work requester to a bidder that has attested a clear conflict check. Sent only where the bid invitation withheld the requester's identity.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.4:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:requesterDisclosed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "invitationReference": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
        },
        "requester": {
          "$ref": "urn:ipproto:schema:0.4:actorReference"
        }
      },
      "required": [
        "invitationReference",
        "requester"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
