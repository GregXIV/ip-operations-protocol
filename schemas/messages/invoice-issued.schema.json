{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.4:invoiceIssued",
  "title": "Invoice Issued",
  "description": "A payee issues an invoice to a payor, for milestones, subscriptions or both. One message for supplier invoices and for the customer invoice; payee and payor say which it is.",
  "allOf": [
    {
      "$ref": "urn:ipproto:schema:0.4:commonEnvelope"
    }
  ],
  "type": "object",
  "properties": {
    "messageType": {
      "const": "urn:ipproto:message:invoiceIssued"
    },
    "payload": {
      "type": "object",
      "properties": {
        "invoiceReference": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
        },
        "invoiceNumber": {
          "type": "string"
        },
        "payee": {
          "type": "object",
          "properties": {
            "actorUri": {
              "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
            },
            "roleDeclarationUri": {
              "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
            }
          },
          "required": [
            "actorUri"
          ]
        },
        "payor": {
          "type": "object",
          "properties": {
            "actorUri": {
              "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
            },
            "roleDeclarationUri": {
              "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
            }
          },
          "required": [
            "actorUri"
          ]
        },
        "invoiceLines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "milestoneReference": {
                "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
              },
              "subscriptionReference": {
                "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
              },
              "billingPeriod": {
                "type": "object",
                "description": "The period a subscription line is charged for. Both dates are inclusive, and 'to' is not before 'from'; the order of the two dates is a rule of the spec that JSON Schema cannot express. Allowed only on a line that carries subscriptionReference. Added in 0.4.",
                "properties": {
                  "from": {
                    "$ref": "urn:ipproto:schema:0.4:defs#/$defs/isoDate"
                  },
                  "to": {
                    "$ref": "urn:ipproto:schema:0.4:defs#/$defs/isoDate"
                  }
                },
                "required": [
                  "from",
                  "to"
                ]
              },
              "lineItemType": {
                "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
              },
              "amount": {
                "type": "number"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "lineItemType",
              "amount"
            ],
            "oneOf": [
              {
                "required": [
                  "milestoneReference"
                ]
              },
              {
                "required": [
                  "subscriptionReference"
                ]
              }
            ],
            "dependentRequired": {
              "billingPeriod": [
                "subscriptionReference"
              ]
            }
          }
        },
        "totalAmount": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/money"
        },
        "taxHandling": {
          "type": "object",
          "properties": {
            "taxTreatment": {
              "description": "Provisional vocabulary: the standard values have not been reviewed by invoice issuers and may change before 1.0.",
              "anyOf": [
                {
                  "enum": [
                    "taxed",
                    "reverseCharge",
                    "exempt",
                    "outsideScope"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
                  "description": "Custom tax treatment: a namespaced URN identifying the defining authority"
                }
              ]
            },
            "taxRatePercent": {
              "type": "number"
            },
            "taxAmount": {
              "type": "number"
            }
          },
          "required": [
            "taxTreatment"
          ]
        },
        "dueDate": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/isoDate"
        },
        "invoiceDocument": {
          "$ref": "urn:ipproto:schema:0.4:defs#/$defs/uri"
        }
      },
      "required": [
        "invoiceReference",
        "invoiceNumber",
        "payee",
        "payor",
        "invoiceLines",
        "totalAmount",
        "taxHandling",
        "dueDate",
        "invoiceDocument"
      ]
    }
  },
  "required": [
    "payload"
  ]
}
