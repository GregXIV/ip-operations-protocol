{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipproto:schema:0.6:defs",
  "title": "Common Defs",
  "$defs": {
    "uri": {
      "type": "string",
      "format": "uri-reference"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "st3Code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "description": "WIPO ST.3 office/country code"
    },
    "iso4217": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "iso639": {
      "type": "string",
      "description": "ISO 639-1 language code"
    },
    "jsonPointer": {
      "type": "string",
      "description": "RFC 6901 JSON Pointer"
    },
    "money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/iso4217"
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    },
    "claimantRef": {
      "type": "object",
      "properties": {
        "actorUri": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "roleDeclarationUri": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        }
      },
      "required": [
        "actorUri",
        "roleDeclarationUri"
      ]
    },
    "prospectiveRight": {
      "type": "object",
      "description": "A right that does not exist yet and that the requested work is to create or prepare: a first filing, or an application to be drafted. Added in 0.3.",
      "properties": {
        "assetType": {
          "enum": [
            "patent",
            "utilityModel",
            "designRegistration",
            "trademark",
            "plantVariety",
            "geographicalIndication",
            "otherIp"
          ]
        },
        "workingTitle": {
          "type": "string"
        },
        "intendedJurisdictions": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.6:defs#/$defs/st3Code"
          }
        },
        "applicant": {
          "$ref": "urn:ipproto:schema:0.6:entityReference"
        },
        "resultingAssetReferences": {
          "type": "array",
          "items": {
            "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
          }
        }
      },
      "required": [
        "assetType",
        "workingTitle"
      ]
    },
    "conflictParty": {
      "type": "object",
      "description": "A party to be checked for conflicts of interest, with its role in the work. Shared by Bid Invitation, Work Instruction, Mandate Instruction and Conflict Check Attested. partyRole adds applicant and namespaced URNs in 0.6.",
      "properties": {
        "partyRole": {
          "anyOf": [
            {
              "enum": [
                "beneficiary",
                "applicant",
                "adverseParty",
                "other"
              ]
            },
            {
              "type": "string",
              "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$",
              "description": "Custom party role: a namespaced URN identifying the defining authority"
            }
          ]
        },
        "party": {
          "$ref": "urn:ipproto:schema:0.6:entityReference"
        }
      },
      "required": [
        "partyRole",
        "party"
      ]
    },
    "identifier": {
      "type": "object",
      "description": "An identifier of an organization or a person, as on Actor Reference. Added to defs in 0.6 for Entity Reference.",
      "properties": {
        "scheme": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/uri"
        },
        "value": {
          "type": "string"
        },
        "verifiedAt": {
          "$ref": "urn:ipproto:schema:0.6:defs#/$defs/isoDateTime"
        },
        "registrationAuthority": {
          "type": "string",
          "description": "The register that issued the identifier; required with the scheme urn:ipproto:scheme:companyRegister."
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "if": {
        "properties": {
          "scheme": {
            "const": "urn:ipproto:scheme:companyRegister"
          }
        },
        "required": [
          "scheme"
        ]
      },
      "then": {
        "required": [
          "registrationAuthority"
        ]
      }
    }
  }
}
